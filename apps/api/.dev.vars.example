ADMIN_TOKEN=dev-admin-token
# Cloudflare Turnstile test secret: always passes (pairs with the test site key in wrangler.toml).
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
HASH_PEPPER=dev-pepper
# 이미지 생성(image_generate). 키는 .dev.vars와 운영 secret에만 둔다.
OPENAI_API_KEY=
# 사용할 OpenAI 이미지 모델 ID. 연동 시점의 최신 모델로 정한다.
OPENAI_IMAGE_MODEL=
