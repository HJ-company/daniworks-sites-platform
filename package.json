{
  "name": "daniworks-sites-platform",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm --filter @sites/renderer build",
    "test": "pnpm -r test",
    "check-types": "pnpm -r check-types",
    "dev:api": "pnpm --filter api dev",
    "dev:router": "pnpm --filter router dev",
    "upload:shared": "node scripts/upload-shared.mjs",
    "verify:m1": "node scripts/verify-m1.mjs",
    "deploy:staging": "pnpm build && pnpm --filter api migrate:staging && pnpm --filter api deploy:staging && pnpm --filter router deploy:staging",
    "verify:staging": "node scripts/verify-staging.mjs"
  }
}
